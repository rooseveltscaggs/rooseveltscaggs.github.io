---
// Hidden page: opts this browser out of Umami analytics.
// Intentionally does not use MainLayout so visiting it is never tracked.
// Visit /no-track to disable tracking, /no-track?enable to re-enable it.
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<title>Analytics</title>
<style>
body {
  margin: 0;
  padding: 0 16px;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  background: #fff;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  color: #212529;
  text-align: center;
}

a {
  color: #3498db;
}
</style>
</head>
<body>
<div>
  <p id="status">Updating analytics preference&hellip;</p>
  <p><a id="toggle" href="/no-track"></a> &middot; <a href="/">Home</a></p>
</div>
<script is:inline>
  const KEY = 'umami.disabled';
  const status = document.getElementById('status');
  const toggle = document.getElementById('toggle');
  const enable = new URLSearchParams(window.location.search).has('enable');

  try {
    if (enable) {
      localStorage.removeItem(KEY);
    } else {
      localStorage.setItem(KEY, '1');
    }

    if (localStorage.getItem(KEY)) {
      status.textContent = 'Umami tracking is disabled for this browser.';
      toggle.textContent = 'Re-enable tracking';
      toggle.href = '/no-track?enable';
    } else {
      status.textContent = 'Umami tracking is enabled for this browser.';
      toggle.textContent = 'Disable tracking';
      toggle.href = '/no-track';
    }
  } catch (e) {
    status.textContent = 'Could not access localStorage in this browser, so the preference was not saved.';
    toggle.textContent = 'Try again';
  }
</script>
</body>
</html>
